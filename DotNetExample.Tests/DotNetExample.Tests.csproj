<Project Sdk="MSTest.Sdk/4.0.1">

  <ItemGroup>
    <ProjectReference Include="..\DotNetExample.Api\DotNetExample.Api.csproj" />
    <ProjectReference Include="..\DotNetExample.Domain\DotNetExample.Domain.csproj" />
    <ProjectReference Include="..\DotNetExample.IoC\DotNetExample.IoC.csproj" />
    <ProjectReference Include="..\DotNetExample.DataAccess\DotNetExample.DataAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="RandomTestValues" Version="2.1.1" />
    <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.5" />
  </ItemGroup>

  <PropertyGroup>
    <UseVSTest>true</UseVSTest>
    <!-- Test fields are assigned in [TestInitialize], which the nullable analysis can't see. -->
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

</Project>
